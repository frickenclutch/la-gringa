{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-gringas",
  "account_id": "0159ef82c2b48adea5a695c46f2312bb",
  "main": "worker.js",
  "compatibility_date": "2026-04-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Create with: npx wrangler kv namespace create MENU_BOARD
  // then replace both IDs. Until then GET falls back to the embedded seed;
  // PUT returns 503 without a real namespace.
  "kv_namespaces": [
    {
      "binding": "MENU_BOARD",
      "id": "00000000000000000000000000000000",
      "preview_id": "00000000000000000000000000000000"
    }
  ]
}
