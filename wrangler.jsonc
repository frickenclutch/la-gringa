{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-gringas",
  "account_id": "0159ef82c2b48adea5a695c46f2312bb",
  "main": "worker.js",
  "compatibility_date": "2026-04-08",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Workers AI: auto-translates owner menu edits between EN and ES.
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "MENU_BOARD",
      "id": "fdc3065f14b44dc4a538b6a9cd2bc267",
      "preview_id": "1b106b4ec4e34a57aaf8b5d21e27c816"
    }
  ]
}
