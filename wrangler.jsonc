{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "la-gringas",
  "account_id": "0159ef82c2b48adea5a695c46f2312bb",
  "main": "worker.js",
  "compatibility_date": "2026-04-08",
  "observability": {
    "enabled": true
  },
  // Custom domains bound to this Worker. This list is the COMPLETE set:
  // wrangler deploy attaches what is here and detaches any custom domain
  // that is not (the record it created goes with it). The apex is the
  // canonical address; every other host here is 301'd to it by worker.js.
  // TODO once the plain `www` DNS record is deleted in the dashboard, add
  //   { "pattern": "www.dirtygringonny.com", "custom_domain": true }
  // and deploy: wrangler refuses to bind a hostname that still has its own
  // A/CNAME record (error 100117).
  "routes": [
    { "pattern": "dirtygringonny.com", "custom_domain": true },
    { "pattern": "new.dirtygringonny.com", "custom_domain": true }
  ],
  // Declaring routes flips wrangler's default for workers.dev to OFF, which
  // would 404 every old la-gringas.the-dirty-gringo.workers.dev link instead
  // of letting worker.js 301 it to the domain. Keep both on explicitly.
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Every request passes through worker.js first so the alias hosts (www.,
    // new., workers.dev), plain http:// and old WordPress paths can 301 to
    // https://dirtygringonny.com before a static page is served.
    "run_worker_first": true
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Workers AI: auto-translates owner menu edits between EN and ES.
  "ai": {
    "binding": "AI"
  },
  "kv_namespaces": [
    {
      "binding": "MENU_BOARD",
      "id": "fdc3065f14b44dc4a538b6a9cd2bc267",
      "preview_id": "1b106b4ec4e34a57aaf8b5d21e27c816"
    }
  ]
}
